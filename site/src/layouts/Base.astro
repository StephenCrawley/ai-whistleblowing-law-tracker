---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer>
      <p>This site is not legal advice. Each entry was checked against the linked official sources on its "last verified" date; laws change, so check the source before relying on it.</p>
    </footer>
  </body>
</html>
