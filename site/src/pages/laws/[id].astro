---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const laws = await getCollection('laws');
  return laws.map((law) => ({ params: { id: law.id }, props: { law } }));
}

const { law } = Astro.props;
const d = law.data;
---
<Base title={d.law}>
  <p><a href="/">All laws</a></p>
  <h1>{d.law}</h1>
  <p>{d.section} · {d.jurisdiction} · {d.status}</p>
  <p>{d.summary}</p>

  <h2>Who is protected</h2>
  <p>{d.who_is_protected}</p>

  <h2>What disclosures are covered</h2>
  <p>{d.disclosures_covered}</p>

  <h2>Where to report</h2>
  <ul>
    {d.reporting_channels.map((c) => (
      <li>
        {c.url ? <a href={c.url}>{c.name}</a> : c.name}
        {c.anonymous && ' (anonymous)'}
        {c.note && <><br /><small>{c.note}</small></>}
      </li>
    ))}
  </ul>

  {d.limits && (
    <>
      <h2>Limits</h2>
      <ul>{d.limits.map((l) => <li>{l}</li>)}</ul>
    </>
  )}

  <h2>Sources</h2>
  <ul>
    {d.sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}
  </ul>
  <p>Last verified: {d.last_verified ?? 'not yet verified'}</p>
</Base>
