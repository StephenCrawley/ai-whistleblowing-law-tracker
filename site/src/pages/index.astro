---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const laws = await getCollection('laws');
---
<Base title="AI Whistleblower Law Tracker">
  <h1>AI Whistleblower Law Tracker</h1>
  <ul>
    {laws.map((law) => (
      <li><a href={`/laws/${law.id}/`}>{law.data.law}</a> ({law.data.jurisdiction})</li>
    ))}
  </ul>
</Base>
